<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.foodrescue</groupId>
    <artifactId>food-rescue-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>food-rescue-platform</name>
    <description>Aggregator POM for all Food Rescue microservices</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sonar.organization>abdotranscript25</sonar.organization>
        <sonar.projectKey>abdotranscript25_food-rescue-platform</sonar.projectKey>

        <!-- ⬇️ AJOUT : Indique à SonarQube où lire le rapport agrégé global -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${maven.multiModuleProjectDirectory}/target/site/jacoco-aggregate/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.coverage.jacoco.aggregateXmlReportPaths>
            ${maven.multiModuleProjectDirectory}/target/site/jacoco-aggregate/jacoco.xml
        </sonar.coverage.jacoco.aggregateXmlReportPaths>
    </properties>

    <modules>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>discovery-service</module>
        <module>notification-service</module>
        <module>offer-service</module>
        <module>payment-service</module>
        <module>product-service</module>
        <module>reservation-service</module>
        <module>user-service</module>
    </modules>

    <!-- ========================================== -->
    <!-- CONFIGURATION JACOCO POUR LA COUVERTURE   -->
    <!-- ========================================== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <excludes>
                        <!-- Exclure les DTOs (pas de logique métier) -->
                        <exclude>**/dto/**</exclude>
                        <!-- Exclure les entités JPA (générées par Hibernate) -->
                        <exclude>**/entity/**</exclude>
                        <!-- Exclure les classes de configuration Spring -->
                        <exclude>**/config/**</exclude>
                        <!-- Exclure la classe main de chaque microservice -->
                        <exclude>**/*Application.class</exclude>
                        <!-- Exclure les repositories (interfaces Spring Data) -->
                        <exclude>**/repository/**</exclude>
                        <!-- Exclure les classes de sécurité (filtres JWT, etc.) -->
                        <exclude>**/security/**</exclude>
                    </excludes>
                </configuration>
                <!-- ⬇️ AJOUT : Liaison au cycle de vie Maven -->
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- ⬇️ AJOUT : Génère un rapport global à la racine -->
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>